# HTTP + WebSocket port for the API/collaboration server
PORT=8787
# Optional: enables the LLM reviewer in Deep review and LLM-backed prompt-to-diagram.
# Any OpenAI-compatible endpoint works (OpenAI, Azure OpenAI, OpenRouter, vLLM, Ollama).
STRATUM_LLM_API_KEY=
STRATUM_LLM_BASE_URL=https://api.openai.com/v1
STRATUM_LLM_MODEL=gpt-4o-mini
# Where room documents are persisted (default: apps/server/data)
STRATUM_DATA_DIR=
